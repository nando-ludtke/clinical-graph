# OpenAI / LiteLLM
OPENAI_API_KEY=your-openai-api-key

# Model routing
# Document classification / PII gate
CLASSIFIER_MODEL=gpt-4o-mini
# Graph creation
NODE_EXTRACTION_MODEL=gpt-4o-mini
EDGE_EXTRACTION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Answer generation
QUERY_REWRITE_MODEL=gpt-4o-mini
ANSWER_GENERATION_MODEL=gpt-4o

# Graph
CLINICAL_GRAPH_GRAPH_K_HOPS=2

# Concurrency
MAX_CONCURRENT_LLM_CALLS=10
# Rate limiting
CLINICAL_GRAPH_RATE_LIMIT_ENABLED=true
CLINICAL_GRAPH_RATE_LIMIT_REQUESTS=60
CLINICAL_GRAPH_RATE_LIMIT_WINDOW_SECONDS=60
# Guardrails
CLINICAL_GUARD_URL=http://localhost:8080
CLINICAL_GUARD_TIMEOUT_SECONDS=2.5
CLINICAL_GUARD_HEALTH_POLL_SECONDS=30

# Showcase Lifecycle
AUTO_PRUNE_NON_FROZEN_HOURS=24

# Verified Web Fallback (Tavily Search API + OpenAI Decisions)
ENABLE_WEB_FALLBACK=false
ENABLE_WEB_PDF_FETCH=false
INCLUDE_REGIONAL_DOMAINS=false
WEB_LABEL_SIMILARITY_THRESHOLD=0.48
TAVILY_API_KEY=your-tavily-api-key
WEB_SEARCH_MODEL=gpt-4o-mini
DECISION_MODEL=gpt-6-luna
