# OpenAI / LiteLLM
OPENAI_API_KEY=your-openai-api-key

# Model routing
# Document classification / PII gate
CLASSIFIER_MODEL=gpt-4o-mini
# Graph creation
NODE_EXTRACTION_MODEL=gpt-4o-mini
EDGE_EXTRACTION_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Answer generation
QUERY_REWRITE_MODEL=gpt-4o-mini
ANSWER_GENERATION_MODEL=gpt-4o

# Concurrency
MAX_CONCURRENT_LLM_CALLS=5

# Rate limiting
CLINICAL_GRAPH_RATE_LIMIT_ENABLED=true
CLINICAL_GRAPH_RATE_LIMIT_REQUESTS=60
CLINICAL_GRAPH_RATE_LIMIT_WINDOW_SECONDS=60
